{
  "layer": "top",
  "reload_on_style_change": true,
  "position": "top",
  "passthrough": false,
  "reload_style_on_change": true,
  "spacing": 10,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 1,
  "modules-left": [
    "custom/icon", 
    "hyprland/window", 
    "custom/weather", 
    "mpris"],
  "modules-center": ["group/workspaces"],
  "modules-right": [
    "tray",
   // "custom/helvum",
   // "custom/easyeffects",
   "memory",
   "cpu",
   "network",
   "bluetooth",
   "pulseaudio",
    "backlight",
    "battery",
    "clock",
    // "custom/icon",
    "custom/power"
  ],
  "custom/icon": {
    "format": ""
  },
  "hyprland/window": {
    "separate-outputs": true,
    "format": "{class}",
    "rewrite": {
      "": "gs",
      "kitty": "gs",
      "foot": "Terminal",
      "firefox": "Browser",
      "microsoft-edge": "Browser",
      "cursor": "Editor",
      "org.pipewire.Helvum": "Helvum",
      "com.github.wwmm.easyeffects": "EasyEffects",
      "com.anthropic.Claude": "Claudião"
    }
  },
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/ws1",
      "custom/ws2",
      "custom/ws3",
      "custom/ws4",
      "custom/ws5",
      "custom/ws6",
      "custom/ws7",
      "custom/ws8",
      "custom/ws9",
      "custom/ws10"
    ]
  },
  "custom/ws1": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 1 i",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 1"
  },
  "custom/ws2": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 2 ii",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 2"
  },
  "custom/ws3": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 3 iii",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 3"
  },
  "custom/ws4": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 4 iv",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 4"
  },
  "custom/ws5": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 5 v",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 5"
  },
  "custom/ws6": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 6 vi",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 6"
  },
  "custom/ws7": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 7 vii",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 7"
  },
  "custom/ws8": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 8 viii",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 8"
  },
  "custom/ws9": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 9 ix",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 9"
  },
  "custom/ws10": {
    "exec": "$HOME/.config/waybar/scripts/ws.sh 10 x",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/ws-click.sh 10"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 5,
    "show-passive-items": true
  },
  "custom/weather": {
    "exec": "python3 ~/.config/waybar/scripts/weather.py",
    "return-type": "json",
    "interval": 1800,
    "format": "{icon} {text}",
    "format-icons": {
      "clear": "󰖙",
      "clouds": "󰖐",
      "rain": "󰖗",
      "snow": "󰖘",
      "storm": "󰖖",
      "default": "󰖐"
    }
  },
  // "custom/helvum": {
  //   "format": "󰲁",
  //   "tooltip-format": "Helvum",
  //   "on-click": "helvum"
  // },
  // "custom/easyeffects": {
  //   "format": "󰺢",
  //   "tooltip-format": "EasyEffects",
  //   "on-click": "easyeffects"
  // },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-bluetooth-muted": "󰂲 {volume}%",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "hands-free": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "easyeffects",
    "on-click-middle": "helvum",
    "tooltip-format": "{desc}\n{volume}%"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃝", "󰃞", "󰃟", "󰃠"],
    "scroll-step": 5,
    "tooltip-format": "Brilho: {percent}%"
  },
  "memory": {
    // "format": "󰍻 {used:0.1f} / {total:0.1f} GiB", 
    "format": "󰍻 {percentage}%",
    "tooltip-format": "Memória: {percentage}% · {used:0.1f} / {total:0.1f} GiB",
    "interval": 1
  },
  "cpu": {
    "format": "󰍛 {usage}%",
    "tooltip-format": "CPU: {usage}%",
    "interval": 1,
    "on-click": "cpu"
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "{icon} {bandwidthDownBytes}",
    "format-ethernet": "󰈀 {bandwidthDownBytes}",
    "format-disconnected": "󰌙",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname} {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Desconectado",
    "on-click": "$HOME/.config/hypr/scripts/wifi-menu.py",
    "on-click-right": "nm-connection-editor",
    "interval": 5
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "format-no-controller": "󰂲",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-disabled": "Bluetooth desabilitado",
    "tooltip-format-off": "Bluetooth desligado",
    "tooltip-format-on": "Ligado · nenhum dispositivo",
    "tooltip-format-connected": "{num_connections} conectado(s)\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-no-controller": "Sem adaptador",
    "on-click": "$HOME/.config/hypr/scripts/bluetooth-menu.py",
    "on-click-right": "bash -c 'if bluetoothctl show | grep -q \"Powered: yes\"; then bluetoothctl power off; else bluetoothctl power on; fi'"
  },
  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "{icon} {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging-icon": "󰂄",
    "format-plugged-icon": "󰚥",
    "tooltip-format": "{timeTo}"
  },
  "clock": {
    "format": "<span></span>  {:%d/%m %H:%M}",
    "interval": 1,
    "tooltip-format": "{:%A, %d de %B de %Y}",
    "on-click": "$HOME/.config/hypr/scripts/calendar.py"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "suspend": "systemctl suspend",
      "logout": "hyprctl dispatch exit"
    }
  },
  "mpris": {
    "player": "spotify",
    "format": "{player_icon} {dynamic}",
    "format-paused": "{player_icon} {dynamic}",
    "tooltip-format": "{title}\n{artist}\n{album}",
    "dynamic-order": ["title", "artist"],
    "dynamic-separator": " · ",
    "max-length": 30,
    "ellipsis": "…",
    "player-icons": {
      "default": "󰝚",
      "spotify": ""
    },
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/spotify_menu.xml",
    "menu-actions": {
      "play-pause": "playerctl -p spotify play-pause",
      "previous": "playerctl -p spotify previous",
      "next": "playerctl -p spotify next",
      "open": "spotify-launcher"
    },
    "on-scroll-up": "playerctl -p spotify previous",
    "on-scroll-down": "playerctl -p spotify next "
  }
}
