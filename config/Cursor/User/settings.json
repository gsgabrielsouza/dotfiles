{
    "window.autoDetectColorScheme": true,
    "workbench.preferredLightColorTheme": "Cursor Dark Midnight",
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Droid Sans Mono', 'monospace', monospace",
    "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09', 'ss10', 'liga'",
    "cursor.composer.queueMessageDefaultBehavior": "steer",
    "cursor.general.glassShowWarningNotifications": true,
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "cursor.composer.conversationDensity": "compact-ungrouped",
    "editor.autoClosingComments": "always"
}