#!/usr/bin/env bash
set -euo pipefail

VPN_NAME="VPN TECHNE"
FORTIVPN="/usr/bin/fortivpn"
GUI="/opt/forticlient/gui/FortiClient"
TRAY="/opt/forticlient/fortitraylauncher"

usage() {
  echo "Uso: $(basename "$0") [connect|disconnect|status]"
  echo "  connect       Conecta na ${VPN_NAME} (SAML no FortiClient)"
  echo "  disconnect    Encerra o túnel"
  echo "  status        Mostra se a VPN está ativa"
}

need_user() {
  if [[ $EUID -eq 0 ]]; then
    echo "O fortivpn precisa rodar como usuário, não como root."
    exit 1
  fi
}

need_fortivpn() {
  if [[ ! -x $FORTIVPN ]]; then
    echo "fortivpn não encontrado em ${FORTIVPN}."
    echo "Instale o FortiClient VPN."
    exit 1
  fi
}

status_line() {
  "$FORTIVPN" status 2>/dev/null | tr -d '\r' | tail -n 1
}

is_connected() {
  [[ $(status_line) == *"Status: Connected"* ]]
}

is_connecting() {
  [[ $(status_line) == *"Status: Connecting"* ]]
}

ensure_saml_ui() {
  if ! pgrep -x fortitraylauncher >/dev/null && ! pgrep -x fortitray >/dev/null; then
    setsid "$TRAY" >/dev/null 2>&1 &
  fi
  if ! pgrep -f "$GUI" >/dev/null; then
    setsid "$GUI" --ozone-platform=x11 >/dev/null 2>&1 &
    local i=0
    while (( i < 25 )) && ! pgrep -f "$GUI" >/dev/null; do
      sleep 0.2
      i=$((i + 1))
    done
    sleep 1
  fi
}

cmd_status() {
  need_fortivpn
  need_user
  local line
  line=$(status_line)
  if is_connected; then
    echo "${VPN_NAME}: conectada"
    printf '%s\n' "$line"
    ip -br addr show ppp0 2>/dev/null || ip -br addr show tun0 2>/dev/null || true
    return 0
  fi
  if is_connecting; then
    echo "${VPN_NAME}: conectando (aguardando SAML)"
    printf '%s\n' "$line"
    return 2
  fi
  echo "${VPN_NAME}: desconectada"
  printf '%s\n' "$line"
  return 1
}

cmd_disconnect() {
  need_fortivpn
  need_user
  if ! is_connected && ! is_connecting; then
    echo "${VPN_NAME} já está desconectada."
    return 0
  fi
  "$FORTIVPN" disconnect
  echo "${VPN_NAME} desconectada."
}

cmd_connect() {
  need_fortivpn
  need_user
  if is_connected; then
    echo "${VPN_NAME} já está conectada."
    cmd_status || true
    return 0
  fi
  if is_connecting; then
    echo "Há uma conexão pendente. Encerrando para reconectar..."
    "$FORTIVPN" disconnect >/dev/null 2>&1 || true
    sleep 1
  fi
  ensure_saml_ui
  echo "Conectando ${VPN_NAME} via FortiClient"
  echo "Conclua o login Microsoft na janela SAML do FortiClient."
  exec "$FORTIVPN" connect "$VPN_NAME"
}

action=${1:-connect}
case $action in
  connect | c | up) cmd_connect ;;
  disconnect | d | down) cmd_disconnect ;;
  status | s) cmd_status ;;
  -h | --help | help) usage ;;
  *)
    usage
    exit 1
    ;;
esac
